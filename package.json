{
  "name": "iiit-bhopal-campus-metaverse",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive browser-based campus metaverse for IIIT Bhopal",
  "scripts": {
    "dev": "concurrently -n CLIENT,SERVER -c blue,green \"npm run dev --workspace=client\" \"npm run dev --workspace=server\"",
    "build": "npm run build --workspace=client",
    "preview": "npm run preview --workspace=client",
    "server": "npm run dev --workspace=server",
    "client": "npm run dev --workspace=client",
    "backend": "npm run dev --workspace=server",
    "frontend": "npm run dev --workspace=client",
    "seed": "npm run seed --workspace=server",
    "test": "npm run test --workspace=server",
    "install:all": "npm install"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
