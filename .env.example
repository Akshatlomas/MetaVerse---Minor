# ==========================================
# IIIT Bhopal Campus Metaverse - Environment Variables
# ==========================================

# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Demo Mode: Set to true to run instantly with in-memory campus dataset (No MongoDB needed)
# Set to false if you want persistent storage in a local/remote MongoDB instance.
DEMO_MODE=true

# Database (used when DEMO_MODE=false)
MONGODB_URI=mongodb://127.0.0.1:27017/iiit_bhopal_metaverse

# AI Assistant Provider: "mock" (default, free, no key needed) | "gemini" | "openai" | "anthropic"
AI_PROVIDER=mock

# Optional API Keys (Only needed if AI_PROVIDER is set to an external service)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Rate Limiting
ASSISTANT_RATE_LIMIT_WINDOW_MS=60000
ASSISTANT_RATE_LIMIT_MAX=30

# LiveKit Real-Time WebRTC Audio & Video Configuration
# Leave blank for built-in local WebSocket WebRTC mesh & audio isolation fallback
LIVEKIT_URL=wss://metaverse.iiitbhopal.ac.in
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_key_iiit_bhopal_metaverse_classroom_2026
