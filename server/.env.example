# ==========================================
# IIIT Bhopal Campus Metaverse - Environment Variables
# ==========================================

PORT=5001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
DEMO_MODE=true
MONGODB_URI=mongodb://127.0.0.1:27017/iiit_bhopal_metaverse
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ASSISTANT_RATE_LIMIT_WINDOW_MS=60000
ASSISTANT_RATE_LIMIT_MAX=30

# LiveKit Real-Time WebRTC Audio & Video Configuration
# Leave blank for built-in local WebSocket WebRTC mesh & audio isolation fallback
LIVEKIT_URL=wss://metaverse.iiitbhopal.ac.in
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_key_iiit_bhopal_metaverse_classroom_2026
